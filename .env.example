# Copy this file to ".env" and edit the values. NEVER commit ".env" to Git.

# --- Core -------------------------------------------------------------
# development | production | testing
APP_ENV=development
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# College timezone used for deadlines and event times
APP_TIMEZONE=Asia/Kolkata

# --- Database ---------------------------------------------------------
# SQLite is used when this is empty (file: instance/collegehub.db).
# PostgreSQL example: postgresql://user:password@host:5432/collegehub
DATABASE_URL=

# --- Uploads ----------------------------------------------------------
# Folder for uploaded PDFs and cover images (kept out of Git).
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=8

# --- AI Event Assistant ----------------------------------------------
# Leave AI_API_KEY empty to run in safe offline "demo mode".
# AI_PROVIDER: anthropic | openai   (openai = any OpenAI-compatible API)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Only needed for OpenAI-compatible providers, e.g. https://api.openai.com/v1
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20

# --- Seed -------------------------------------------------------------
# Password given to every demo account created by `flask seed`.
DEMO_PASSWORD=CollegeHub@2026

# --- Demo / seed accounts (override if you like; never use real credentials) ---
# DEMO_FACULTY_USERNAME=collegehub_faculty
# DEMO_ORGANIZER_USERNAME=collegehub_org
# DEMO_LOGISTICS_USERNAME=collegehub_logistics

# --- Password reset and e-mail ---
# RESET_TOKEN_MAX_AGE=3600          # seconds a reset link stays valid
# DEMO_SHOW_RESET_LINK=0            # 1 = show reset link on screen (demo only, insecure)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=CollegeHub <no-reply@your-college.example>
